# .gitignore — VIOLET

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
backend/lib/
backend/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
.venv/
.venv-ppo/
backend/.wheelhouse/*
!backend/.wheelhouse/.gitkeep
backend/.pytest-tmp/
.ENV

# Jupyter
.ipynb_checkpoints/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment variables
.env
.env.local
.env.*.local

# Build artifacts
*.log
*.tmp
*.bak

# Backend runs / artifacts
runs/
artifacts/
experiments/
# Keep the app's legacy /experiments redirect despite the artifacts pattern.
!frontend/app/experiments/
!frontend/app/experiments/page.tsx
*.pt
*.pth
*.h5
*.pkl
*.pickle

# Database
*.db
*.sqlite
*.sqlite3

# Frontend
frontend/.next/
frontend/node_modules/
frontend/out/
frontend/.turbo/
frontend/test-results/
frontend/playwright-report/

# OS
.DS_Store
Thumbs.db

# Coverage
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.cover

# Docker override
docker-compose.override.yml
